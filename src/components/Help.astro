---
import Layout from '../layouts/Layout.astro';
import zh from '../data/zh-CN/help.json';
import en from '../data/en-US/help.json';
import { renderHelp } from '../lib/help.mjs';
import {helpDescription} from '../lib/seo.mjs';
const { language='zh-CN', section='intro', doc='about' }=Astro.props;
const data=language==='en-US'?en:zh;
const item=(data.sections as any)[section].docs[doc];
const base=import.meta.env.BASE_URL;
const help=`${base}${language==='en-US'?'en/':''}help/`;
const canonicalPath=`${help}${section}/${doc}/`;
const url=new URL(canonicalPath,Astro.site).href;
const root=new URL(base,Astro.site).href;
const structuredData=[{'@type':'TechArticle',headline:item.title,description:helpDescription(item.body),inLanguage:language,url,dateModified:item.updated,author:{'@id':`${root}#organization`},mainEntityOfPage:{'@id':`${url}#webpage`}}, {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:language==='en-US'?'Home':'首页',item:new URL(`${base}${language==='en-US'?'en/':''}`,Astro.site).href},{'@type':'ListItem',position:2,name:language==='en-US'?'Help':'帮助',item:new URL(help,Astro.site).href},{'@type':'ListItem',position:3,name:item.title,item:url}]}];
---
<Layout title={`${item.title} · ${language==='en-US'?'BigLazyCat Writer':'大懒猫写作'}`} language={language} description={helpDescription(item.body)} canonicalPath={canonicalPath} structuredData={structuredData}>
  <div class="help-layout"><aside><input id="help-search" type="search" placeholder={language==='en-US'?'Search docs':'搜索帮助文档'} aria-label={language==='en-US'?'Search docs':'搜索帮助文档'} />{Object.entries(data.sections).map(([key, group])=><section><h2>{group.title}</h2>{Object.entries(group.docs).map(([id, value])=><a class:list={['help-link', {'active':key===section&&id===doc}]} href={`${help}${key}/${id}/`}>{value.title}</a>)}</section>)}</aside><article><h1>{item.title}</h1><p class="updated">{item.updated}</p><div class="prose" set:html={renderHelp(item.body,base,language)} /></article></div>
</Layout>
<script>
  document.querySelector('#help-search')?.addEventListener('input', event=>{const value=(event.target as HTMLInputElement).value.toLowerCase();document.querySelectorAll<HTMLAnchorElement>('.help-link').forEach(link=>{link.hidden=!link.textContent?.toLowerCase().includes(value);});});
</script>
<style is:global>
  .help-layout{max-width:1400px;margin:auto;display:grid;grid-template-columns:280px minmax(0,1fr);gap:64px;padding:40px 28px}.help-layout aside{height:calc(100vh - 150px);overflow:auto;position:sticky;top:110px}.help-layout aside h2{font-size:14px;margin-top:26px}.help-link{display:block;font-size:14px;padding:7px 12px;text-decoration:none;border-radius:6px;color:#6b6b70}.help-link[hidden]{display:none}.help-link.active{background:#e5e9ef;color:#2f4b7c}.help-layout input{width:95%;padding:12px;border:1px solid #d2d2d0;border-radius:6px}.help-layout article{max-width:880px;min-width:0}.help-layout h1{font-size:32px}.updated{color:#6b6b70;font-size:13px}.prose{line-height:1.9}.prose h2{margin-top:48px;border-bottom:1px solid #d2d2d0;padding-bottom:12px}.prose h3{margin-top:30px}.prose pre{background:#eaeaee;padding:20px;overflow:auto;border-radius:8px}.prose code{font-size:13px;overflow-wrap:anywhere}.prose table{display:block;overflow:auto;border-collapse:collapse}.prose td,.prose th{border:1px solid #d2d2d0;padding:10px}.prose a{color:#2f4b7c}.prose blockquote{border-left:3px solid #2f4b7c;padding-left:20px}.prose img{max-width:100%}@media(max-width:850px){.help-layout{grid-template-columns:1fr;gap:20px;padding:24px 18px}.help-layout aside{position:static;height:220px;border-bottom:1px solid #d2d2d0}.help-layout h1{font-size:26px}}
</style>
