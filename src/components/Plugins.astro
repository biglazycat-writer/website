---
import Layout from '../layouts/Layout.astro';
import data from '../data/plugins.json';
import { validateCatalog, packageSize } from '../lib/plugins.mjs';
import { ArrowUpRight, ArrowDown, Download, Check, Search, Puzzle, BookOpen, Send, ChevronRight } from 'lucide-react';
const {language='zh-CN'}=Astro.props;
const english=language==='en-US';
const catalog=validateCatalog(data) as typeof data;
const title=english?'Plugins for your next creative step | BigLazyCat Creator':'插件 · 让创作多一种可能 | 大懒猫创作平台';
const description=english?'Discover plugins for BigLazyCat Creator. Browse WeChat publishing and typeset export, compare versions and download from your preferred source.':'发现大懒猫创作平台插件：微信公众号发布、文章排版与书籍导出。查看功能、版本和兼容要求，自由选择官网或 GitHub 下载。';
const categories=english?{all:'All plugins',publishing:'Publishing',export:'Export & design'}:{all:'全部插件',publishing:'内容发布',export:'排版与导出'};
---
<Layout language={language} title={title} description={description}>
  <div class="plugins-landing">
    <section class="plugin-hero">
      <div class="hero-copy"><p class="eyebrow"><span></span>{english?'THE PLUGIN COLLECTION':'为灵感，多添一双手'}</p>
        <h1>{english?'Your next chapter.':'创作的下一步，'}<br/><em>{english?'A little more possible.':'交给好工具。'}</em></h1>
        <p class="hero-description">{english?'Writing is just the beginning. Publish it, design it, make it a book. Find a tool for what comes next.':'写下文字，只是开始。让文章走进公众号，让灵感成为一本书。挑一款合适的插件，延伸你的创作方式。'}</p>
        <a class="hero-link" href="#collection">{english?'Explore the collection':'发现插件'}<ArrowDown size={16}/></a>
      </div>
      <div class="hero-art" aria-hidden="true"><div class="art-orbit"></div><div class="art-tile tile-writing"><span>文</span><small>WRITE</small></div><div class="art-connector connector-a"></div><div class="art-tile tile-publish"><Send size={36}/><small>PUBLISH</small></div><div class="art-connector connector-b"></div><div class="art-tile tile-book"><BookOpen size={38}/><small>CREATE</small></div><span class="art-note">{english?'One workspace. More possibilities.':'一个工作台，更多可能。'}</span></div>
    </section>
    <section class="collection" id="collection" aria-labelledby="collection-title">
      <div class="collection-heading"><div><p class="eyebrow">THE COLLECTION</p><h2 id="collection-title">{english?'Made for your workflow':'为你的创作而来'}</h2></div><p>{english?'Small additions. New possibilities.':'从常用的小工具，到完整的创作工作台。'}</p></div>
      <div class="collection-toolbar"><div class="category-filters" role="group" aria-label={english?'Plugin category':'插件分类'}>{Object.entries(categories).map(([id,label])=><button type="button" data-category={id} aria-pressed={id==='all'}>{label}</button>)}</div><label class="plugin-search"><Search size={17}/><span class="sr-only">{english?'Search plugins':'搜索插件'}</span><input id="plugin-search" type="search" placeholder={english?'Find your next tool…':'找一款好工具…'}/><kbd>/</kbd></label></div>
      <div class="plugin-grid">{catalog.plugins.map((plugin,index)=>{
        const release=plugin.releases[0];
        const isPublish=plugin.icon==='publish';
        const name=english?plugin.nameEn:plugin.name;
        return <article class:list={['plugin-card',isPublish?'publish-card':'export-card']} data-plugin-category={plugin.category} data-plugin-search={`${plugin.name} ${plugin.nameEn} ${plugin.description} ${plugin.descriptionEn} ${plugin.features.join(' ')}`.toLowerCase()}>
          <div class="plugin-preview" aria-hidden="true"><span class="preview-label">{isPublish?'PUBLISH YOUR VOICE':'MAKE IT TANGIBLE'}</span><span class="preview-number">0{index+1}</span>
            {isPublish?<><div class="article-sheet"><span class="sheet-kicker">灵感来信 · THE CREATIVE LETTER</span><div class="sheet-rule"></div><strong>让好内容<br/>被更多人看见<span>。</span></strong><p>每一个认真写下的句子，<br/>都值得一次漂亮的呈现。</p><div class="sheet-lines"><i></i><i></i><i></i></div></div><div class="draft-stamp"><Check size={15}/>{english?'Ready for your draft box':'准备好，送进草稿箱'}</div></>:<><div class="book-shadow"></div><div class="book-cover"><span>THE ART OF MAKING</span><strong>把灵感<br/>装订成书</strong><i></i><small>文字的另一种可能<br/>A COLLECTION OF IDEAS</small></div><div class="format-stamp">PDF <span>·</span> EPUB <span>·</span> DOCX</div></>}
          </div>
          <div class="plugin-card-body"><div class="plugin-title-row"><span class="plugin-icon">{isPublish?<Send size={22}/>:<BookOpen size={23}/>}</span><div><h3>{name}</h3><p>{english?'By BigLazyCat Creator':plugin.author}</p></div><span class="version">v{release.version}</span></div><p class="plugin-description">{english?plugin.descriptionEn:plugin.description}</p><ul class="plugin-features">{(english?plugin.featuresEn:plugin.features).map(feature=><li><Check size={13}/>{feature}</li>)}</ul>
            <div class="plugin-downloads"><p><Download size={14}/>{english?'Choose your download source':'选择下载来源'}<span>{packageSize(release.size)}</span></p><div>{release.downloads.map(source=><a class:list={['source-link',source.id==='official'&&'source-primary']} href={source.url} data-event="plugin_download" data-plugin={plugin.id} data-source={source.id} download>{english?source.nameEn:source.name}<ArrowUpRight size={15}/></a>)}</div></div>
            <div class="plugin-card-meta"><span>{english?'Desktop': '桌面端'} ≥ {release.minimumClientVersion}</span><a href={`${plugin.homepage}/releases/tag/v${release.version}`} target="_blank" rel="noopener noreferrer">{english?'Release notes':'版本说明'}<ChevronRight size={13}/></a></div>
            <details class="checksum"><summary>{english?'Verify package · SHA-256':'校验安装包 · SHA-256'}</summary><code>{release.sha256}</code></details>
          </div>
        </article>;
      })}</div>
      <p class="search-empty" hidden>{english?'No plugins match. Try another search or category.':'没有找到匹配的插件，试试其他关键词或分类。'}</p>
      <p class="collection-count" aria-live="polite" data-count-template={english?'Showing {count} plugins':'共 {count} 款插件'}>{english?`Showing ${catalog.plugins.length} plugins`:`共 ${catalog.plugins.length} 款插件`}</p>
    </section>
    <section class="plugin-how"><div><p class="eyebrow">A FEW SIMPLE STEPS</p><h2>{english?'A new tool, a familiar home.':'新工具，熟悉的工作台。'}</h2><p>{english?'Install plugins in the desktop app. Your tools stay close to your writing.':'在桌面端安装插件，让工具出现在你熟悉的创作流程中。'}</p></div><ol><li><span>01</span><div><h3>{english?'Pick a plugin':'挑选插件'}</h3><p>{english?'Explore its features and check the required desktop version.':'看看功能介绍，确认适用的客户端版本。'}</p></div></li><li><span>02</span><div><h3>{english?'Choose how to install':'选择安装方式'}</h3><p>{english?'Use the desktop plugin store when available, or download a package here and import it in Plugins → Install plugin.':'支持插件商店的桌面版可直接安装；也可在这里下载安装包，在「插件 → 安装插件 → 插件包」中导入。'}</p></div></li><li><span>03</span><div><h3>{english?'Make it part of your process':'开始创作'}</h3><p>{english?'Confirm that you trust the plugin, then find its tools in your workspace.':'确认信任插件后，启用它的页面和命令。'}</p></div></li></ol></section>
    <section class="plugin-developer"><div class="developer-icon"><Puzzle size={28}/></div><div><p class="eyebrow">BUILD SOMETHING OF YOUR OWN</p><h2>{english?'Your idea could be the next plugin.':'你的好点子，也可以成为插件。'}</h2><p>{english?'Start with the SDK and template. Build a tool that fits the way you create.':'从 SDK 和模板出发，为自己的创作方式，做一款顺手的工具。'}</p></div><a href="https://github.com/biglazycat-writer/blc-plugin-template" target="_blank" rel="noopener noreferrer">{english?'Start building':'开始开发'}<ArrowUpRight size={17}/></a></section>
  </div>
</Layout>
<script>
  const search=document.querySelector<HTMLInputElement>('#plugin-search');
  const filters=[...document.querySelectorAll<HTMLButtonElement>('[data-category]')];
  const cards=[...document.querySelectorAll<HTMLElement>('[data-plugin-category]')];
  let category='all';
  function update(){let count=0;const query=(search?.value||'').trim().toLowerCase();for(const card of cards){const visible=(category==='all'||card.dataset.pluginCategory===category)&&(card.dataset.pluginSearch||'').includes(query);card.hidden=!visible;if(visible)count++;}const empty=document.querySelector<HTMLElement>('.search-empty');if(empty)empty.hidden=count!==0;const label=document.querySelector<HTMLElement>('.collection-count');if(label)label.textContent=label.dataset.countTemplate?.replace('{count}',String(count))||'';}
  search?.addEventListener('input',update);
  for(const button of filters)button.addEventListener('click',()=>{category=button.dataset.category||'all';for(const filter of filters)filter.setAttribute('aria-pressed',String(filter===button));update();});
  document.addEventListener('keydown',event=>{if(event.key==='/'&&!event.ctrlKey&&!event.metaKey&&!event.altKey&&!['INPUT','TEXTAREA','SELECT'].includes((event.target as HTMLElement)?.tagName)&&!(event.target as HTMLElement)?.isContentEditable){event.preventDefault();search?.focus();}});
</script>
<style>
  .plugins-landing{max-width:1200px;margin:0 auto;padding:0 32px}.plugin-hero{display:grid;grid-template-columns:1.15fr 1fr;align-items:center;gap:56px;padding:90px 0 88px}.eyebrow{display:flex;align-items:center;gap:9px;font-size:10px;letter-spacing:.16em;font-weight:600;color:var(--portal-text-3);margin:0 0 22px}.eyebrow>span{width:6px;height:6px;background:#43836d;border-radius:50%}h1{font-family:var(--portal-serif);font-size:clamp(38px,4.5vw,60px);line-height:1.35;letter-spacing:-.045em;margin:0 0 24px;font-weight:600}h1 em{font-style:normal;color:#658575}.hero-description{max-width:440px;font-size:15px;line-height:2;color:var(--portal-text-3);margin-bottom:30px}.hero-link{display:inline-flex;align-items:center;gap:22px;font-size:13px;text-decoration:none;border-bottom:1px solid var(--portal-border-2);padding:0 0 10px}.hero-art{height:290px;position:relative;isolation:isolate}.art-orbit{position:absolute;inset:4px 30px 20px 24px;border:1px dashed #cfd5cd;border-radius:50%;transform:rotate(-25deg)}.art-tile{position:absolute;width:116px;height:124px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;border:1px solid #fff9;border-radius:18px;box-shadow:0 14px 30px #24342d0c}.art-tile small{font-size:8px;letter-spacing:.16em;font-weight:600;opacity:.6}.tile-writing{top:74px;left:8px;background:#fffdf8;transform:rotate(-10deg);z-index:1}.tile-writing>span{font-family:var(--portal-serif);font-size:40px;line-height:1}.tile-publish{top:12px;left:42%;background:#e1eee5;color:#3d725c;transform:rotate(9deg)}.tile-book{bottom:22px;right:4px;background:#e9e4f0;color:#74638c;transform:rotate(-7deg)}.art-connector{position:absolute;height:1px;background:#c8cfc7;z-index:-1}.connector-a{width:140px;left:90px;top:108px;transform:rotate(-25deg)}.connector-b{width:130px;right:50px;top:166px;transform:rotate(45deg)}.art-note{position:absolute;bottom:-14px;left:40px;font-size:10px;letter-spacing:.08em;color:var(--portal-text-4)}.collection{padding-bottom:44px}.collection-heading{border-top:1px solid var(--portal-border);padding-top:38px;display:flex;justify-content:space-between;align-items:flex-end;gap:20px}.collection-heading .eyebrow{margin-bottom:10px}.collection-heading h2,.plugin-how h2,.plugin-developer h2{font-size:26px;letter-spacing:-.02em;font-weight:500;margin:0}.collection-heading>p{font-size:12px;color:var(--portal-text-3);margin:0 0 3px}.collection-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:30px 0 24px}.category-filters{display:flex;gap:6px;flex-wrap:wrap}.category-filters button{border:1px solid transparent;border-radius:6px;padding:8px 13px;color:var(--portal-text-3);font-size:12px;background:transparent;cursor:pointer}.category-filters button[aria-pressed=true]{background:var(--portal-bg-soft);border-color:var(--portal-border);color:var(--portal-text);box-shadow:0 2px 3px #00000003}.plugin-search{display:flex;align-items:center;gap:9px;color:var(--portal-text-4);padding:9px 12px;border:1px solid var(--portal-border);border-radius:7px;background:#ffffff66}.plugin-search input{font:inherit;font-size:12px;width:165px;max-width:100%;color:var(--portal-text);background:none;outline:0;border:0}.plugin-search:focus-within{outline:2px solid var(--focus-ring-soft)}.plugin-search kbd{font:10px monospace;border:1px solid var(--portal-border);padding:1px 4px;border-radius:3px}.plugin-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px}.plugin-card{border:1px solid var(--portal-border);border-radius:14px;overflow:hidden;background:var(--portal-bg-soft);transition:box-shadow .2s,transform .2s}.plugin-card:hover{box-shadow:0 14px 36px #1f30290b;transform:translateY(-3px)}.plugin-card[hidden]{display:none}.plugin-preview{position:relative;height:286px;overflow:hidden;border-bottom:1px solid #00000005}.publish-card .plugin-preview{background:#e3ede6}.export-card .plugin-preview{background:#e9e4ed}.preview-label{position:absolute;left:24px;top:22px;font-size:8px;letter-spacing:.17em;color:#526659}.preview-number{position:absolute;right:22px;top:16px;font-family:var(--portal-serif);font-size:24px;color:#00000025}.article-sheet{position:absolute;left:50%;top:54px;transform:translateX(-50%) rotate(-5deg);width:260px;height:290px;padding:24px 25px;background:#fffdf6;box-shadow:0 9px 20px #28473312}.sheet-kicker{font-size:6px;letter-spacing:.08em;color:#677668}.sheet-rule{height:1px;background:#bcc7b8;margin:11px 0 18px}.article-sheet strong{display:block;font-family:var(--portal-serif);font-size:29px;line-height:1.4;letter-spacing:-.02em;font-weight:600}.article-sheet strong span{color:#638c6d}.article-sheet p{font-family:var(--portal-serif);font-size:8px;line-height:1.9;color:#8a8a7e}.sheet-lines{display:grid;gap:6px;margin-top:16px}.sheet-lines i{height:2px;background:#e1e4dc}.sheet-lines i:last-child{width:70%}.draft-stamp{position:absolute;right:26px;bottom:24px;display:flex;align-items:center;gap:8px;padding:12px 17px;border:1px solid #ffffff70;border-radius:9px;background:#426b53;color:#fff;font-size:10px;box-shadow:0 7px 20px #1f4a3226;transform:rotate(3deg)}.book-cover,.book-shadow{position:absolute;left:50%;top:49px;width:184px;height:250px;transform:translateX(-50%) rotate(8deg);border-radius:1px 5px 5px 1px}.book-shadow{background:#c3b6ce;transform:translateX(-40%) rotate(-5deg);top:56px}.book-cover{background:#695c79;color:#f6f0e5;padding:24px 24px 20px 30px;box-shadow:inset 6px 0 5px #0002,0 12px 20px #44304b28}.book-cover>span{font-size:6px;letter-spacing:.16em;white-space:nowrap}.book-cover strong{font-family:var(--portal-serif);display:block;font-size:28px;line-height:1.45;margin-top:28px;font-weight:500}.book-cover i{display:block;width:28px;height:1px;background:#d6c9a6;margin:16px 0}.book-cover small{font-size:6px;line-height:1.9;letter-spacing:.08em;opacity:.7}.format-stamp{position:absolute;bottom:25px;left:24px;background:#ffffffde;padding:11px 13px;box-shadow:0 3px 10px #3427390a;border:1px solid white;border-radius:6px;font-size:9px;letter-spacing:.03em;transform:rotate(-3deg)}.format-stamp span{color:#a79cad;margin:0 5px}.plugin-card-body{padding:26px 27px 20px}.plugin-title-row{display:flex;align-items:center;gap:12px}.plugin-icon{width:43px;height:43px;display:grid;place-items:center;border:1px solid #00000007;border-radius:11px;background:#eef5ee;color:#508065;flex:none}.export-card .plugin-icon{color:#78658d;background:#f0ecf5}.plugin-title-row h3{font-size:18px;letter-spacing:-.02em;font-weight:600;margin:0 0 5px}.plugin-title-row p{font-size:9px;color:var(--portal-text-4);margin:0}.version{margin-left:auto;font-size:10px;color:var(--portal-text-3);padding:4px 8px;background:var(--portal-bg-surface,#f6f6f3);border:1px solid var(--portal-border);border-radius:5px;white-space:nowrap}.plugin-description{font-size:13px;line-height:1.9;color:var(--portal-text-3);min-height:50px;margin:20px 0 16px}.plugin-features{list-style:none;display:flex;flex-wrap:wrap;gap:8px 14px;padding:0;margin:0 0 26px}.plugin-features li{font-size:10px;color:var(--portal-text-2);display:flex;align-items:center;gap:4px}.plugin-features svg{color:#7a9481}.plugin-downloads{border-top:1px solid var(--portal-border);padding-top:16px}.plugin-downloads>p{display:flex;align-items:center;gap:6px;font-size:10px;color:var(--portal-text-3);margin:0 0 12px}.plugin-downloads>p>span{margin-left:auto;font-variant-numeric:tabular-nums;color:var(--portal-text-4)}.plugin-downloads>div{display:flex;gap:8px;flex-wrap:wrap}.source-link{display:flex;justify-content:space-between;align-items:center;gap:22px;border:1px solid var(--portal-border);border-radius:6px;padding:10px 13px;min-width:112px;font-size:11px;text-decoration:none}.source-link:hover{border-color:#708676;background:#f3f6f2}.source-primary{background:#262e29;border-color:#262e29;color:#fff}.source-primary:hover{background:#425548;color:white}.plugin-card-meta{display:flex;justify-content:space-between;gap:12px;margin-top:17px;font-size:9px;color:var(--portal-text-4)}.plugin-card-meta a{display:flex;align-items:center;gap:2px;text-decoration:none}.checksum{font-size:9px;color:var(--portal-text-4);margin-top:12px}.checksum summary{cursor:pointer}.checksum code{display:block;word-break:break-all;line-height:1.8;padding:9px;background:var(--portal-bg);margin-top:8px;border-radius:4px}.collection-count{text-align:center;font-size:10px;color:var(--portal-text-4);margin:22px 0 0}.search-empty{padding:70px 20px;text-align:center;font-size:14px;color:var(--portal-text-3)}.plugin-how{display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid var(--portal-border);padding:58px 0}.plugin-how .eyebrow{margin-bottom:15px}.plugin-how>div>p:last-child{font-size:13px;color:var(--portal-text-3);line-height:1.9;max-width:300px}.plugin-how ol{list-style:none;margin:0;padding:0;display:grid;gap:24px}.plugin-how li{display:flex;gap:20px}.plugin-how li>span{font-family:var(--portal-serif);font-size:17px;color:#95a99a;line-height:1.5}.plugin-how h3{font-size:13px;font-weight:500;margin:0 0 6px}.plugin-how li p{font-size:12px;color:var(--portal-text-3);line-height:1.8;margin:0}.plugin-developer{border:1px solid var(--portal-border);border-radius:12px;display:flex;align-items:center;gap:24px;padding:30px;margin:0 0 70px;background:#ffffff40}.developer-icon{width:56px;height:56px;border:1px dashed #aebcae;border-radius:13px;display:grid;place-items:center;color:#7a927d;flex:none;transform:rotate(-7deg)}.plugin-developer .eyebrow{font-size:8px;margin-bottom:9px}.plugin-developer h2{font-size:19px}.plugin-developer p:last-child{font-size:12px;color:var(--portal-text-3);margin-bottom:0;line-height:1.8}.plugin-developer>a{display:flex;align-items:center;gap:20px;margin-left:auto;white-space:nowrap;font-size:12px;text-decoration:none;border-bottom:1px solid var(--portal-border-2);padding-bottom:7px}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}a:focus-visible,button:focus-visible,summary:focus-visible{outline:2px solid #658575;outline-offset:4px}
  @media(max-width:800px){.plugins-landing{padding:0 22px}.plugin-hero{padding:56px 0;gap:20px}.hero-art{transform:scale(.8);transform-origin:right center}.collection-heading{align-items:flex-start;flex-direction:column;gap:12px}.plugin-card-body{padding:22px 20px 18px}.plugin-preview{height:260px}.plugin-how{gap:32px}.plugin-title-row h3{font-size:16px}.plugin-title-row{gap:9px}.version{font-size:9px}.plugin-icon{width:36px;height:36px}.plugin-developer{gap:18px;padding:24px}.developer-icon{display:none}}
  @media(max-width:600px){.plugin-hero{grid-template-columns:1fr;padding:46px 0 36px;gap:0}.hero-art{display:none}h1{font-size:42px}.hero-description{font-size:13px}.collection-heading h2{font-size:24px}.collection-toolbar{align-items:stretch;flex-direction:column;gap:14px}.category-filters{gap:4px}.category-filters button{padding:8px 11px}.plugin-search input{width:100%;min-width:0;flex:1}.plugin-grid{grid-template-columns:1fr;gap:22px}.plugin-preview{height:280px}.plugin-card-body{padding:24px}.plugin-how{grid-template-columns:1fr;gap:24px;padding:40px 0}.plugin-how h2{font-size:23px}.plugin-developer{align-items:flex-start;flex-direction:column;margin-bottom:40px}.plugin-developer>a{margin:0}.plugin-developer h2{font-size:18px}.collection-heading>p{line-height:1.7}.plugin-description{min-height:0}}
</style>
