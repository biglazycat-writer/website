---
import Layout from '../layouts/Layout.astro';
import data from '../data/plugins.json';
import { validateCatalog, packageSize } from '../lib/plugins.mjs';
import { ArrowUpRight, Download, Check, Search, Puzzle, BookOpen, Send, ChevronRight } from 'lucide-react';
const {language='zh-CN'}=Astro.props;
const english=language==='en-US';
const catalog=validateCatalog(data) as typeof data;
const title=english?'Plugins for your next creative step | BigLazyCat Creator':'插件 · 让创作多一种可能 | 大懒猫创作平台';
const description=english?'Discover plugins for BigLazyCat Creator. Browse WeChat publishing and typeset export, compare versions and download from your preferred source.':'发现大懒猫创作平台插件：微信公众号发布、文章排版与书籍导出。查看功能、版本和兼容要求，自由选择官网或 GitHub 下载。';
const categories=english?{all:'All plugins',publishing:'Publishing',export:'Export & design'}:{all:'全部插件',publishing:'内容发布',export:'排版与导出'};
---
<Layout language={language} title={title} description={description}>
  <div class="plugins-landing">
    <section class="plugin-hero">
      <div class="hero-copy"><p class="eyebrow"><span></span>{english?'THE PLUGIN COLLECTION':'为灵感，多添一双手'}</p>
        <h1>{english?'More tools for your writing.':'为创作，添一款好工具。'}</h1>
        <p class="hero-description">{english?'Publish, typeset and export with plugins that fit your workflow.':'发现发布、排版与导出插件，让常用工具加入你的创作流程。'}</p>
      </div>
      <div class="hero-art" aria-hidden="true"><span class="art-tile tile-writing"><Puzzle size={23}/></span><span class="art-tile tile-publish"><Send size={23}/></span><span class="art-tile tile-book"><BookOpen size={23}/></span></div>
    </section>
    <section class="collection" id="collection" aria-labelledby="collection-title">
      <div class="collection-heading"><div><p class="eyebrow">THE COLLECTION</p><h2 id="collection-title">{english?'Made for your workflow':'为你的创作而来'}</h2></div><p>{english?'Small additions. New possibilities.':'从常用的小工具，到完整的创作工作台。'}</p></div>
      <div class="collection-toolbar"><div class="category-filters" role="group" aria-label={english?'Plugin category':'插件分类'}>{Object.entries(categories).map(([id,label])=><button type="button" data-category={id} aria-pressed={id==='all'}>{label}</button>)}</div><label class="plugin-search"><Search size={17}/><span class="sr-only">{english?'Search plugins':'搜索插件'}</span><input id="plugin-search" type="search" placeholder={english?'Find your next tool…':'找一款好工具…'}/><kbd>/</kbd></label></div>
      <div class="plugin-grid">{catalog.plugins.map(plugin=>{
        const release=plugin.releases[0];
        const isPublish=plugin.icon==='publish';
        const name=english?plugin.nameEn:plugin.name;
        return <article class:list={['plugin-card',isPublish?'publish-card':'export-card']} data-plugin-category={plugin.category} data-plugin-search={`${plugin.name} ${plugin.nameEn} ${plugin.description} ${plugin.descriptionEn} ${plugin.features.join(' ')}`.toLowerCase()}>
          <div class="plugin-card-body"><div class="plugin-title-row"><span class="plugin-icon">{isPublish?<Send size={22}/>:<BookOpen size={23}/>}</span><div><h3>{name}</h3><p>{english?'By BigLazyCat Creator':plugin.author}</p></div><span class="version">v{release.version}</span></div><p class="plugin-description">{english?plugin.descriptionEn:plugin.description}</p><ul class="plugin-features">{(english?plugin.featuresEn:plugin.features).map(feature=><li><Check size={13}/>{feature}</li>)}</ul>
            <div class="plugin-downloads"><p><Download size={14}/>{english?'Choose your download source':'选择下载来源'}<span>{packageSize(release.size)}</span></p><div>{release.downloads.map(source=><a class:list={['source-link',source.id==='official'&&'source-primary']} href={source.url} data-event="plugin_download" data-plugin={plugin.id} data-source={source.id} download>{english?source.nameEn:source.name}<ArrowUpRight size={15}/></a>)}</div></div>
            <div class="plugin-card-meta"><span>{english?'Desktop': '桌面端'} ≥ {release.minimumClientVersion}</span><a href={`${plugin.homepage}/releases/tag/v${release.version}`} target="_blank" rel="noopener noreferrer">{english?'Release notes':'版本说明'}<ChevronRight size={13}/></a></div>
            <details class="checksum"><summary>{english?'Verify package · SHA-256':'校验安装包 · SHA-256'}</summary><code>{release.sha256}</code></details>
          </div>
        </article>;
      })}</div>
      <p class="search-empty" hidden>{english?'No plugins match. Try another search or category.':'没有找到匹配的插件，试试其他关键词或分类。'}</p>
      <p class="collection-count" aria-live="polite" data-count-template={english?'Showing {count} plugins':'共 {count} 款插件'}>{english?`Showing ${catalog.plugins.length} plugins`:`共 ${catalog.plugins.length} 款插件`}</p>
    </section>
    <section class="plugin-how"><div><p class="eyebrow">A FEW SIMPLE STEPS</p><h2>{english?'A new tool, a familiar home.':'新工具，熟悉的工作台。'}</h2><p>{english?'Install plugins in the desktop app. Your tools stay close to your writing.':'在桌面端安装插件，让工具出现在你熟悉的创作流程中。'}</p></div><ol><li><span>01</span><div><h3>{english?'Pick a plugin':'挑选插件'}</h3><p>{english?'Explore its features and check the required desktop version.':'看看功能介绍，确认适用的客户端版本。'}</p></div></li><li><span>02</span><div><h3>{english?'Choose how to install':'选择安装方式'}</h3><p>{english?'Use the desktop plugin store when available, or download a package here and import it in Plugins → Install plugin.':'支持插件商店的桌面版可直接安装；也可在这里下载安装包，在「插件 → 安装插件 → 插件包」中导入。'}</p></div></li><li><span>03</span><div><h3>{english?'Make it part of your process':'开始创作'}</h3><p>{english?'Confirm that you trust the plugin, then find its tools in your workspace.':'确认信任插件后，启用它的页面和命令。'}</p></div></li></ol></section>
    <section class="plugin-developer"><div class="developer-icon"><Puzzle size={28}/></div><div><p class="eyebrow">BUILD SOMETHING OF YOUR OWN</p><h2>{english?'Your idea could be the next plugin.':'你的好点子，也可以成为插件。'}</h2><p>{english?'Start with the SDK and template. Build a tool that fits the way you create.':'从 SDK 和模板出发，为自己的创作方式，做一款顺手的工具。'}</p></div><a href="https://github.com/biglazycat-writer/blc-plugin-template" target="_blank" rel="noopener noreferrer">{english?'Start building':'开始开发'}<ArrowUpRight size={17}/></a></section>
  </div>
</Layout>
<script>
  const search=document.querySelector<HTMLInputElement>('#plugin-search');
  const filters=[...document.querySelectorAll<HTMLButtonElement>('[data-category]')];
  const cards=[...document.querySelectorAll<HTMLElement>('[data-plugin-category]')];
  let category='all';
  function update(){let count=0;const query=(search?.value||'').trim().toLowerCase();for(const card of cards){const visible=(category==='all'||card.dataset.pluginCategory===category)&&(card.dataset.pluginSearch||'').includes(query);card.hidden=!visible;if(visible)count++;}const empty=document.querySelector<HTMLElement>('.search-empty');if(empty)empty.hidden=count!==0;const label=document.querySelector<HTMLElement>('.collection-count');if(label)label.textContent=label.dataset.countTemplate?.replace('{count}',String(count))||'';}
  search?.addEventListener('input',update);
  for(const button of filters)button.addEventListener('click',()=>{category=button.dataset.category||'all';for(const filter of filters)filter.setAttribute('aria-pressed',String(filter===button));update();});
  document.addEventListener('keydown',event=>{if(event.key==='/'&&!event.ctrlKey&&!event.metaKey&&!event.altKey&&!['INPUT','TEXTAREA','SELECT'].includes((event.target as HTMLElement)?.tagName)&&!(event.target as HTMLElement)?.isContentEditable){event.preventDefault();search?.focus();}});
</script>
<style>
  .plugins-landing{max-width:1200px;margin:0 auto;padding:0 32px}
  .plugin-hero{display:flex;align-items:center;justify-content:space-between;gap:32px;padding:36px 0 28px}
  .hero-copy{min-width:0}.eyebrow{display:flex;align-items:center;gap:8px;font-size:10px;letter-spacing:.12em;font-weight:600;color:var(--portal-text-3);margin:0 0 10px}.eyebrow>span{width:6px;height:6px;background:#43836d;border-radius:50%}
  h1{font-family:var(--portal-serif);font-size:34px;line-height:1.35;letter-spacing:-.035em;margin:0 0 10px;font-weight:600}
  .hero-description{font-size:13px;line-height:1.8;color:var(--portal-text-3);margin:0}
  .hero-art{display:flex;align-items:center;gap:10px;padding:10px 6px;flex:none}.art-tile{width:48px;height:54px;display:grid;place-items:center;border:1px solid #fff9;border-radius:12px;box-shadow:0 6px 16px #24342d08}.tile-writing{background:#fffdf8;transform:rotate(-8deg)}.tile-publish{background:#e1eee5;color:#3d725c;transform:translateY(-8px) rotate(7deg)}.tile-book{background:#e9e4f0;color:#74638c;transform:rotate(-5deg)}
  .collection{padding-bottom:32px}.collection-heading{border-top:1px solid var(--portal-border);padding-top:24px;display:flex;justify-content:space-between;align-items:flex-end;gap:16px}.collection-heading .eyebrow{margin-bottom:7px}.collection-heading h2,.plugin-how h2,.plugin-developer h2{font-size:22px;letter-spacing:-.02em;font-weight:500;margin:0}.collection-heading>p{font-size:12px;color:var(--portal-text-3);margin:0 0 3px}
  .collection-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:20px 0 16px}.category-filters{display:flex;gap:5px;flex-wrap:wrap}.category-filters button{border:1px solid transparent;border-radius:6px;padding:7px 11px;color:var(--portal-text-3);font-size:12px;background:transparent;cursor:pointer}.category-filters button[aria-pressed=true]{background:var(--portal-bg-soft);border-color:var(--portal-border);color:var(--portal-text)}
  .plugin-search{display:flex;align-items:center;gap:8px;color:var(--portal-text-4);padding:8px 10px;border:1px solid var(--portal-border);border-radius:7px;background:#ffffff66}.plugin-search input{font:inherit;font-size:12px;width:165px;max-width:100%;color:var(--portal-text);background:none;outline:0;border:0}.plugin-search:focus-within{outline:2px solid var(--focus-ring-soft)}.plugin-search kbd{font:10px monospace;border:1px solid var(--portal-border);padding:1px 4px;border-radius:3px}
  .plugin-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.plugin-card{display:flex;min-width:0;border:1px solid var(--portal-border);border-radius:10px;background:var(--portal-bg-soft);transition:box-shadow .2s,border-color .2s}.plugin-card:hover{box-shadow:0 6px 20px #1f302909;border-color:#b6c3b8}.plugin-card[hidden]{display:none}.plugin-card-body{display:flex;flex-direction:column;min-width:0;flex:1;padding:18px}
  .plugin-title-row{display:flex;align-items:center;gap:9px}.plugin-title-row>div{min-width:0}.plugin-icon{width:36px;height:36px;display:grid;place-items:center;border:1px solid #00000007;border-radius:9px;background:#eef5ee;color:#508065;flex:none}.export-card .plugin-icon{color:#78658d;background:#f0ecf5}.plugin-title-row h3{font-size:16px;letter-spacing:-.02em;font-weight:600;margin:0 0 3px;overflow-wrap:anywhere}.plugin-title-row p{font-size:10px;color:var(--portal-text-4);margin:0}.version{margin-left:auto;font-size:10px;color:var(--portal-text-3);padding:3px 6px;background:var(--portal-bg-surface,#f6f6f3);border:1px solid var(--portal-border);border-radius:5px;white-space:nowrap;flex:none}
  .plugin-description{font-size:12px;line-height:1.8;color:var(--portal-text-3);margin:12px 0 10px}.plugin-features{list-style:none;display:flex;flex-wrap:wrap;gap:5px 10px;padding:0;margin:0 0 14px}.plugin-features li{font-size:10px;line-height:1.6;color:var(--portal-text-2);display:flex;align-items:center;gap:3px}.plugin-features svg{color:#7a9481;flex:none}
  .plugin-downloads{border-top:1px solid var(--portal-border);padding-top:12px;margin-top:auto}.plugin-downloads>p{display:flex;align-items:center;gap:5px;font-size:10px;color:var(--portal-text-3);margin:0 0 9px}.plugin-downloads>p>span{margin-left:auto;font-variant-numeric:tabular-nums;color:var(--portal-text-4)}.plugin-downloads>div{display:flex;gap:8px;flex-wrap:wrap}.source-link{display:flex;justify-content:space-between;align-items:center;gap:12px;border:1px solid var(--portal-border);border-radius:6px;padding:7px 10px;min-width:100px;font-size:11px;text-decoration:none}.source-link:hover{border-color:#708676;background:#f3f6f2}.source-primary{background:#262e29;border-color:#262e29;color:#fff}.source-primary:hover{background:#425548;color:white}
  .plugin-card-meta{display:flex;justify-content:space-between;gap:10px;margin-top:12px;font-size:10px;color:var(--portal-text-4)}.plugin-card-meta a{display:flex;align-items:center;gap:2px;text-decoration:none}.checksum{font-size:10px;color:var(--portal-text-4);margin-top:9px}.checksum summary{cursor:pointer}.checksum code{display:block;word-break:break-all;line-height:1.8;padding:8px;background:var(--portal-bg);margin-top:8px;border-radius:4px}.collection-count{text-align:center;font-size:10px;color:var(--portal-text-4);margin:18px 0 0}.search-empty{padding:40px 16px;text-align:center;font-size:13px;color:var(--portal-text-3)}
  .plugin-how{display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid var(--portal-border);padding:40px 0}.plugin-how .eyebrow{margin-bottom:12px}.plugin-how>div>p:last-child{font-size:13px;color:var(--portal-text-3);line-height:1.9;max-width:300px}.plugin-how ol{list-style:none;margin:0;padding:0;display:grid;gap:20px}.plugin-how li{display:flex;gap:16px}.plugin-how li>span{font-family:var(--portal-serif);font-size:17px;color:#95a99a;line-height:1.5}.plugin-how h3{font-size:13px;font-weight:500;margin:0 0 6px}.plugin-how li p{font-size:12px;color:var(--portal-text-3);line-height:1.8;margin:0}
  .plugin-developer{border:1px solid var(--portal-border);border-radius:12px;display:flex;align-items:center;gap:20px;padding:24px;margin:0 0 48px;background:#ffffff40}.developer-icon{width:48px;height:48px;border:1px dashed #aebcae;border-radius:11px;display:grid;place-items:center;color:#7a927d;flex:none;transform:rotate(-7deg)}.plugin-developer .eyebrow{font-size:8px;margin-bottom:9px}.plugin-developer h2{font-size:19px}.plugin-developer p:last-child{font-size:12px;color:var(--portal-text-3);margin-bottom:0;line-height:1.8}.plugin-developer>a{display:flex;align-items:center;gap:16px;margin-left:auto;white-space:nowrap;font-size:12px;text-decoration:none;border-bottom:1px solid var(--portal-border-2);padding-bottom:7px}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}a:focus-visible,button:focus-visible,summary:focus-visible{outline:2px solid #658575;outline-offset:4px}
  @media(max-width:1020px){.plugin-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-art{gap:6px}.art-tile{width:40px;height:46px}.plugin-how{gap:32px}.plugin-developer{gap:18px}.developer-icon{display:none}}
  @media(max-width:680px){.plugins-landing{padding:0 20px}.plugin-hero{padding:26px 0 22px}.hero-art{display:none}h1{font-size:28px}.hero-description{font-size:12px}.collection-heading{padding-top:20px;align-items:flex-start;flex-direction:column;gap:8px}.collection-heading h2{font-size:21px}.collection-toolbar{align-items:stretch;flex-direction:column;gap:12px;margin:16px 0}.plugin-search input{width:100%;min-width:0;flex:1}.plugin-grid{grid-template-columns:1fr;gap:12px}.plugin-card-body{padding:16px}.plugin-how{grid-template-columns:1fr;gap:20px;padding:30px 0}.plugin-how h2{font-size:21px}.plugin-developer{align-items:flex-start;flex-direction:column;margin-bottom:32px;padding:20px}.plugin-developer>a{margin:0}.plugin-developer h2{font-size:18px}.collection-heading>p{line-height:1.7}}
</style>
